# Public application origin used for Supabase authentication email callbacks.
NEXT_PUBLIC_BASE_URL=https://clublinked.com

# Supabase project URL - found in Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key - found in Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase Personal Access Token for local CLI/MCP use.
# Keep the real token in .env.local and never commit it.
